# Copie para .env:  copy .env.example .env   (PowerShell)  |  cp .env.example .env
# NUNCA faça commit do .env com chaves reais.

# demo = resultado pré-preparado (sem internet) | real = análise feita por LLM
SCANNER_MODE=demo

# Qualquer endpoint compatível com a API OpenAI (/chat/completions)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
# Defina false se o provedor não aceitar response_format=json_object
LLM_JSON_MODE=true

# Segredo FICTÍCIO usado pela versão corrigida (lido do ambiente, não do código)
JWT_SECRET=lab-only-fake-secret-change-me

FRONTEND_PORT=8088
DEMO_DELAY_MS=1800
